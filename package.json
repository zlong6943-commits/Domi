{
  "name": "domi",
  "version": "0.3.1",
  "description": "Domi is a tiny animated desktop dog for macOS.",
  "author": "zlong6943-commits",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "main": "out/main/main.js",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "dev": "pnpm build:native && electron-vite dev",
    "build": "pnpm build:native && tsc --noEmit && electron-vite build",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build && electron-builder --mac",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:dir:mac": "pnpm build && electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "com.domi.app",
    "productName": "Domi",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Domi",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "pet_assets",
        "to": "pet_assets",
        "filter": [
          "**/*",
          "!.DS_Store"
        ]
      },
      {
        "from": "native/bin/pawpal-mouse-monitor",
        "to": "native/pawpal-mouse-monitor"
      }
    ]
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
